{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "corepack enable && corepack prepare pnpm@9.15.9 --activate && pnpm install --frozen-lockfile && pnpm --filter @chopsave/shared build && pnpm --filter @chopsave/api build"
  },
  "deploy": {
    "preDeployCommand": [
      "pnpm --filter @chopsave/api migrate"
    ],
    "startCommand": "pnpm --filter @chopsave/api start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "environments": {
    "staging": {
      "deploy": {
        "preDeployCommand": [
          "pnpm --filter @chopsave/api migrate",
          "pnpm --filter @chopsave/api seed"
        ]
      }
    }
  }
}
